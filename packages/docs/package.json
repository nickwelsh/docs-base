{
    "name": "@nickwelsh/docs-base",
    "version": "1.0.1",
    "description": "A complete shared documentation application for MDX and Refquill content.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nickwelsh/docs-base.git",
        "directory": "packages/docs"
    },
    "bin": {
        "docs-base": "./cli.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "THIRD_PARTY_NOTICES",
        "licenses",
        "cli.js"
    ],
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./components": {
            "types": "./dist/components.d.ts",
            "import": "./dist/components.js"
        },
        "./mdx": {
            "types": "./dist/mdx.d.ts",
            "import": "./dist/mdx.js"
        },
        "./source": {
            "types": "./dist/source.d.ts",
            "import": "./dist/source.js"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "import": "./dist/config.js"
        },
        "./waku": {
            "types": "./dist/waku.d.ts",
            "import": "./dist/waku.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js"
        },
        "./code": {
            "types": "./dist/code.d.ts",
            "import": "./dist/code.js"
        },
        "./refquill": {
            "types": "./dist/refquill.d.ts",
            "import": "./dist/refquill.js"
        },
        "./styles.css": "./dist/styles.css",
        "./app": {
            "types": "./dist/app.d.ts",
            "import": "./dist/app.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "check": "tsc --noEmit",
        "test": "node --test tests/*.test.ts",
        "prepack": "pnpm build"
    },
    "dependencies": {
        "@babel/parser": "^8.0.7",
        "@base-ui/react": "1.9.0",
        "@iconify-json/carbon": "^1.2.28",
        "@mdx-js/mdx": "^3.1.1",
        "@nickwelsh/refquill-fumadocs": "^0.1.0",
        "@svgr/core": "^8.1.0",
        "@svgr/plugin-jsx": "^8.1.0",
        "@yutengjing/vscode-icons": "0.2.0",
        "cn": "^0.5.0",
        "fumadocs-twoslash": "^4.0.3",
        "hast-util-to-jsx-runtime": "2.3.6",
        "next-themes": "^0.4.6",
        "react-aria": "3.53.1",
        "react-aria-components": "^1.22.1",
        "shiki": "^4.5.0",
        "tailwind-variants": "^3.3.1",
        "unplugin-icons": "^24.0.0",
        "vite": "^8.3.5",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/mdx": "^2.0.14",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "fumadocs-core": "16.17.7",
        "fumadocs-mdx": "15.4.9",
        "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.5",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-server-dom-webpack": "19.3.1",
        "tailwindcss": "^4.3.3",
        "tailwindcss-react-aria-components": "^2.2.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "waku": "1.0.0-rc.3"
    },
    "peerDependencies": {
        "fumadocs-core": "16.17.7",
        "fumadocs-mdx": "15.4.9",
        "fumadocs-ui": "16.17.5",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-server-dom-webpack": "19.3.1",
        "waku": "1.0.0-rc.3"
    },
    "engines": {
        "node": ">=22.18.0"
    }
}
