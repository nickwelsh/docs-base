{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "declaration": true,
        "declarationMap": false,
        "sourceMap": false,
        "outDir": "dist",
        "rootDir": "src",
        "types": ["node", "vite/client"],
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"]
    },
    "include": ["src"]
}
